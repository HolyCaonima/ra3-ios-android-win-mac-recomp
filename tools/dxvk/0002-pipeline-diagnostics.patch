+  // Opt-in capture of the actual pipeline inputs, including specialization.
+  // Shader dumps from DxvkIrShader::dump use the unspecialized library path.
+  static void dumpStage(const VkPipelineShaderStageCreateInfo& stage,
+                        const VkShaderModuleCreateInfo& info) {
+    const char* path = std::getenv("RA3_DXVK_PIPELINE_DUMP");
+    if (!path || !*path)
+      return;
+    static std::atomic<uint32_t> next = { 0u };
+    uint32_t id = next.fetch_add(1u);
+    if (id >= 128u)
+      return;
+    char name[1024];
+    std::snprintf(name, sizeof(name), "%s/pipeline-%03u-stage%u.spv", path, id, uint32_t(stage.stage));
+    if (auto f = std::fopen(name, "wb")) {
+      std::fwrite(info.pCode, 1u, info.codeSize, f);
+      std::fclose(f);
+    }
+    std::snprintf(name, sizeof(name), "%s/pipeline-%03u-stage%u.spec", path, id, uint32_t(stage.stage));
+    if (auto f = std::fopen(name, "w")) {
+      if (stage.pSpecializationInfo) {
+        const auto& spec = *stage.pSpecializationInfo;
+        for (uint32_t i = 0; i < spec.mapEntryCount; i++) {
+          const auto& entry = spec.pMapEntries[i];
+          if (entry.size == sizeof(uint32_t) && entry.offset + entry.size <= spec.dataSize) {
+            uint32_t value;
+            std::memcpy(&value, static_cast<const char*>(spec.pData) + entry.offset, sizeof(value));
+            std::fprintf(f, "%u %u\n", entry.constantID, value);
+          }
+        }
+      }
+      std::fclose(f);
+    }
+    std::fprintf(stderr, "[ra3-vk] captured stage %u id %u (%zu bytes)\n", uint32_t(stage.stage), id, info.codeSize);
+  }
