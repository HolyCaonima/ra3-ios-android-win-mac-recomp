diff --git a/src/dxvk/dxvk_android_compat.cpp b/src/dxvk/dxvk_android_compat.cpp
new file mode 100644
index 0000000..801f5ce
--- /dev/null
+++ b/src/dxvk/dxvk_android_compat.cpp
@@ -0,0 +1,173 @@
+#include <vector>
+
+#include "dxvk_android_compat.h"
+
+#include "dxvk_include.h"
+
+namespace dxvk::android_compat {
+
+  // One device per process in practice; the wrappers need the real entry points.
+  static PFN_vkCreateGraphicsPipelines s_createGraphicsPipelines = nullptr;
+  static PFN_vkCreateComputePipelines  s_createComputePipelines  = nullptr;
+  static PFN_vkCreateShaderModule      s_createShaderModule      = nullptr;
+  static PFN_vkDestroyShaderModule     s_destroyShaderModule     = nullptr;
+
+
+  /**
+   * \brief Structures unlinked from pNext chains for one call
+   *
+   * The chains are the caller's (DXVK's own locals); a structure the driver
+   * must not see is unlinked for the duration of the call and put back after,
+   * so nothing has to know the size of the structures to copy them.
+   */
+  class ChainEdits {
+
+  public:
+
+    ~ChainEdits() {
+      for (auto i = m_edits.rbegin(); i != m_edits.rend(); i++)
+        *i->link = i->node;
+    }
+
+    // Unlinks the first structure of the given type; returns it or null.
+    const VkBaseInStructure* unlink(const void** head, VkStructureType sType) {
+      auto link = reinterpret_cast<const VkBaseInStructure**>(head);
+
+      while (*link && (*link)->sType != sType)
+        link = const_cast<const VkBaseInStructure**>(&(*link)->pNext);
+
+      const VkBaseInStructure* node = *link;
+
+      if (node) {
+        m_edits.push_back({ link, node });
+        *link = node->pNext;
+      }
+
+      return node;
+    }
+
+  private:
+
+    struct Edit {
+      const VkBaseInStructure** link;
+      const VkBaseInStructure*  node;
+    };
+
+    std::vector<Edit> m_edits;
+
+  };
+
+
+  // Legacy flags from the flags2 struct in the chain, if any (the low
+  // 32 bits of the flags2 bits are the legacy bits by definition).
+  static VkPipelineCreateFlags takeFlags2(const void** pNext, ChainEdits& edits) {
+    auto f2 = reinterpret_cast<const VkPipelineCreateFlags2CreateInfo*>(
+      edits.unlink(pNext, VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO));
+
+    return f2 ? VkPipelineCreateFlags(f2->flags & 0xffffffffu) : 0u;
+  }
+
+
+  // Replaces an inline VkShaderModuleCreateInfo with a module made for it.
+  static VkResult fixStage(VkDevice device, VkPipelineShaderStageCreateInfo& stage,
+          ChainEdits& edits, std::vector<VkShaderModule>& made) {
+    if (stage.module)
+      return VK_SUCCESS;
+
+    auto inl = reinterpret_cast<const VkShaderModuleCreateInfo*>(
+      edits.unlink(&stage.pNext, VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO));
+
+    if (!inl)
+      return VK_SUCCESS;
+
+    VkShaderModuleCreateInfo info = *inl;
+    info.pNext = nullptr;
+
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkResult vr = s_createShaderModule(device, &info, nullptr, &module);
+
+    if (vr)
+      return vr;
+
+    made.push_back(module);
+    stage.module = module;
+    return VK_SUCCESS;
+  }
+
+
+  static VKAPI_ATTR VkResult VKAPI_CALL createGraphicsPipelines(
+          VkDevice                          device,
+          VkPipelineCache                   cache,
+          uint32_t                          count,
+    const VkGraphicsPipelineCreateInfo*     pInfos,
+    const VkAllocationCallbacks*            pAllocator,
+          VkPipeline*                       pPipelines) {
+    // Stage arrays are copied (their module field changes); the create infos
+    // are copied too, and only their pNext chains are edited in place.
+    std::vector<VkGraphicsPipelineCreateInfo> infos(pInfos, pInfos + count);
+    std::vector<std::vector<VkPipelineShaderStageCreateInfo>> stages(count);
+    std::vector<VkShaderModule> made;
+    ChainEdits edits;
+    VkResult vr = VK_SUCCESS;
+
+    for (uint32_t i = 0; i < count && !vr; i++) {
+      infos[i].flags |= takeFlags2(&infos[i].pNext, edits);
+
+      stages[i].assign(infos[i].pStages, infos[i].pStages + infos[i].stageCount);
+
+      for (auto& s : stages[i]) {
+        if ((vr = fixStage(device, s, edits, made)))
+          break;
+      }
+
+      infos[i].pStages = stages[i].data();
+    }
+
+    if (!vr)
+      vr = s_createGraphicsPipelines(device, cache, count, infos.data(), pAllocator, pPipelines);
+
+    for (auto m : made)
+      s_destroyShaderModule(device, m, nullptr);
+
+    return vr;
+  }
+
+
+  static VKAPI_ATTR VkResult VKAPI_CALL createComputePipelines(
+          VkDevice                          device,
+          VkPipelineCache                   cache,
+          uint32_t                          count,
+    const VkComputePipelineCreateInfo*      pInfos,
+    const VkAllocationCallbacks*            pAllocator,
+          VkPipeline*                       pPipelines) {
+    std::vector<VkComputePipelineCreateInfo> infos(pInfos, pInfos + count);
+    std::vector<VkShaderModule> made;
+    ChainEdits edits;
+    VkResult vr = VK_SUCCESS;
+
+    for (uint32_t i = 0; i < count && !vr; i++) {
+      infos[i].flags |= takeFlags2(&infos[i].pNext, edits);
+      vr = fixStage(device, infos[i].stage, edits, made);
+    }
+
+    if (!vr)
+      vr = s_createComputePipelines(device, cache, count, infos.data(), pAllocator, pPipelines);
+
+    for (auto m : made)
+      s_destroyShaderModule(device, m, nullptr);
+
+    return vr;
+  }
+
+
+  void installPipelineFallbacks(vk::DeviceFn& vkd) {
+    s_createGraphicsPipelines = vkd.vkCreateGraphicsPipelines;
+    s_createComputePipelines  = vkd.vkCreateComputePipelines;
+    s_createShaderModule      = vkd.vkCreateShaderModule;
+    s_destroyShaderModule     = vkd.vkDestroyShaderModule;
+
+    vkd.vkCreateGraphicsPipelines = &createGraphicsPipelines;
+    vkd.vkCreateComputePipelines  = &createComputePipelines;
+  }
+
+}
diff --git a/src/dxvk/dxvk_android_compat.h b/src/dxvk/dxvk_android_compat.h
new file mode 100644
index 0000000..753f5fd
--- /dev/null
+++ b/src/dxvk/dxvk_android_compat.h
@@ -0,0 +1,20 @@
+#pragma once
+
+// RA3 (liftingCPath D007): fallbacks for drivers without VK_KHR_maintenance5,
+// as on Android's gfxstream and older Adreno/Mali drivers. Installed into the
+// device's dispatch table right after vkCreateDevice.
+
+#include "dxvk_include.h"
+
+namespace dxvk::android_compat {
+
+  /**
+   * \brief Wraps pipeline creation for a device without maintenance5
+   *
+   * Turns VkPipelineCreateFlags2CreateInfo into legacy pipeline flags (the
+   * low 32 bits mean the same) and VkShaderModuleCreateInfo chained into a
+   * stage into a real, temporary VkShaderModule.
+   */
+  void installPipelineFallbacks(vk::DeviceFn& vkd);
+
+}
