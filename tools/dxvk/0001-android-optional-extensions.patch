diff --git a/src/wsi/android/wsi_platform_android.cpp b/src/wsi/android/wsi_platform_android.cpp
new file mode 100644
index 0000000..6d3c05b
--- /dev/null
+++ b/src/wsi/android/wsi_platform_android.cpp
@@ -0,0 +1,214 @@
+#if defined(DXVK_WSI_ANDROID)
+
+/* RA3 (liftingCPath D007): WSI on Android (docs/ANDROID.md). Designed after
+ * the lessons of nfsu2-recompiled's dxvk-native port (no code from it):
+ *
+ * - the HWND is a stable token; the ANativeWindow behind it is swapped by the
+ *   shell, and each new window bumps a generation the swap chain watches
+ *   (dxvk_android_window_generation) to rebuild its surface;
+ * - every VkSurface holds a reference on the ANativeWindow it was made from
+ *   (released with the surface: dxvk_android_surface_destroyed), since a
+ *   surface that outlives its window crashes drivers;
+ * - the window's buffers are sized to the game's back buffer
+ *   (ANativeWindow_setBuffersGeometry) and the compositor scales them, so
+ *   the size DXVK asks for is the size it gets;
+ * - one monitor whose modes are the usual PC ones, plus the window's own.
+ */
+
+#include <android/native_window.h>
+#include <mutex>
+#include <unordered_map>
+
+#define VK_USE_PLATFORM_ANDROID_KHR 1
+#include "wsi_platform_android.h"
+#include "../../vulkan/vulkan_loader.h"
+#include <vulkan/vulkan_android.h>
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+#include "native/wsi/native_android.h"
+
+namespace {
+  std::mutex          g_mutex;
+  ANativeWindow*      g_window = nullptr;
+  uint32_t            g_generation = 0;
+  uint32_t            g_width = 1280, g_height = 720;      /* the game's back buffer */
+  std::unordered_map<uint64_t, ANativeWindow*> g_surface_window;   /* the reference each surface holds */
+}
+
+extern "C" {
+
+  /* The shell: the activity's window (NULL when it goes). */
+  __attribute__((visibility("default"))) void dxvk_android_set_window(ANativeWindow* window) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (window == g_window)
+      return;
+    if (window) {
+      ANativeWindow_acquire(window);
+      ANativeWindow_setBuffersGeometry(window, int32_t(g_width), int32_t(g_height), 0);
+    }
+    if (g_window)
+      ANativeWindow_release(g_window);
+    g_window = window;
+    g_generation++;
+  }
+
+  __attribute__((visibility("default"))) uint32_t dxvk_android_window_generation() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_generation;
+  }
+
+  __attribute__((visibility("default"))) void* dxvk_android_hwnd() {
+    return dxvk::wsi::androidHwnd();
+  }
+
+  /* The presenter destroyed a surface: release the window it held (createSurface). */
+  void dxvk_android_surface_destroyed(uint64_t surface) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = g_surface_window.find(surface);
+    if (it == g_surface_window.end())
+      return;
+    ANativeWindow_release(it->second);
+    g_surface_window.erase(it);
+  }
+
+}
+
+namespace dxvk::wsi {
+
+  static const HMONITOR g_monitor = reinterpret_cast<HMONITOR>(uintptr_t(1));
+
+  std::vector<const char *> AndroidWsiDriver::getInstanceExtensions() {
+    return { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_ANDROID_SURFACE_EXTENSION_NAME };
+  }
+
+  HMONITOR AndroidWsiDriver::getDefaultMonitor() { return g_monitor; }
+  HMONITOR AndroidWsiDriver::enumMonitors(uint32_t index) { return index ? nullptr : g_monitor; }
+  HMONITOR AndroidWsiDriver::enumMonitors(const LUID *[], uint32_t, uint32_t index) { return enumMonitors(index); }
+
+  bool AndroidWsiDriver::getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) {
+    if (hMonitor != g_monitor)
+      return false;
+    const WCHAR name[] = { '\\', '\\', '.', '\\', 'D', 'I', 'S', 'P', 'L', 'A', 'Y', '1', 0 };
+    std::memcpy(Name, name, sizeof(name));
+    return true;
+  }
+
+  /* The desktop is the size of the game's back buffer: the game's own idea
+   * of the screen, which the compositor scales to the display. */
+  bool AndroidWsiDriver::getDesktopCoordinates(HMONITOR hMonitor, RECT* pRect) {
+    if (hMonitor != g_monitor)
+      return false;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    *pRect = { 0, 0, LONG(g_width), LONG(g_height) };
+    return true;
+  }
+
+  static const uint32_t s_modes[][2] = {
+    { 800, 600 }, { 1024, 768 }, { 1280, 720 }, { 1280, 800 }, { 1366, 768 },
+    { 1600, 900 }, { 1920, 1080 }, { 2560, 1440 },
+  };
+
+  bool AndroidWsiDriver::getDisplayMode(HMONITOR hMonitor, uint32_t modeNumber, WsiMode* pMode) {
+    if (hMonitor != g_monitor || modeNumber >= std::size(s_modes))
+      return false;
+    pMode->width = s_modes[modeNumber][0];
+    pMode->height = s_modes[modeNumber][1];
+    pMode->refreshRate = WsiRational { 60, 1 };
+    pMode->bitsPerPixel = 32;
+    pMode->interlaced = false;
+    return true;
+  }
+
+  bool AndroidWsiDriver::getCurrentDisplayMode(HMONITOR hMonitor, WsiMode* pMode) {
+    if (hMonitor != g_monitor)
+      return false;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    pMode->width = g_width;
+    pMode->height = g_height;
+    pMode->refreshRate = WsiRational { 60, 1 };
+    pMode->bitsPerPixel = 32;
+    pMode->interlaced = false;
+    return true;
+  }
+
+  bool AndroidWsiDriver::getDesktopDisplayMode(HMONITOR hMonitor, WsiMode* pMode) {
+    return getCurrentDisplayMode(hMonitor, pMode);
+  }
+
+  WsiEdidData AndroidWsiDriver::getMonitorEdid(HMONITOR) { return {}; }
+
+  void AndroidWsiDriver::getWindowSize(HWND, uint32_t* pWidth, uint32_t* pHeight) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (pWidth) *pWidth = g_width;
+    if (pHeight) *pHeight = g_height;
+  }
+
+  /* The back buffer's size: the window's buffers follow, the compositor scales. */
+  void AndroidWsiDriver::resizeWindow(HWND, DxvkWindowState*, uint32_t width, uint32_t height) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!width || !height)
+      return;
+    g_width = width;
+    g_height = height;
+    if (g_window)
+      ANativeWindow_setBuffersGeometry(g_window, int32_t(width), int32_t(height), 0);
+  }
+
+  void AndroidWsiDriver::saveWindowState(HWND, DxvkWindowState*, bool) { }
+  void AndroidWsiDriver::restoreWindowState(HWND, DxvkWindowState*, bool) { }
+
+  bool AndroidWsiDriver::setWindowMode(HMONITOR, HWND hWindow, DxvkWindowState* pState, const WsiMode& mode) {
+    resizeWindow(hWindow, pState, mode.width, mode.height);
+    return true;
+  }
+
+  bool AndroidWsiDriver::enterFullscreenMode(HMONITOR, HWND, DxvkWindowState*, bool) { return true; }
+  bool AndroidWsiDriver::leaveFullscreenMode(HWND, DxvkWindowState*) { return true; }
+  bool AndroidWsiDriver::restoreDisplayMode() { return true; }
+  HMONITOR AndroidWsiDriver::getWindowMonitor(HWND) { return g_monitor; }
+  bool AndroidWsiDriver::isWindow(HWND hWindow) { return isAndroidHwnd(hWindow); }
+
+  bool AndroidWsiDriver::isMinimized(HWND) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_window == nullptr;
+  }
+
+  bool AndroidWsiDriver::isOccluded(HWND hWindow) { return isMinimized(hWindow); }
+  void AndroidWsiDriver::updateFullscreenWindow(HMONITOR, HWND, bool) { }
+
+  /* A surface on the current window, holding a reference on it; none (and
+   * SURFACE_LOST, which the presenter retries) while the app has no window. */
+  VkResult AndroidWsiDriver::createSurface(HWND hWindow, PFN_vkGetInstanceProcAddr pfnVkGetInstanceProcAddr,
+                                           VkInstance instance, VkSurfaceKHR* pSurface) {
+    if (!isAndroidHwnd(hWindow))
+      return VK_ERROR_SURFACE_LOST_KHR;
+    auto create = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+    if (!create)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!g_window)
+      return VK_ERROR_SURFACE_LOST_KHR;
+    VkAndroidSurfaceCreateInfoKHR info = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    info.window = g_window;
+    VkResult vr = create(instance, &info, nullptr, pSurface);
+    if (vr == VK_SUCCESS) {
+      ANativeWindow_acquire(g_window);       /* released by dxvk_android_surface_destroyed */
+      g_surface_window[uint64_t(*pSurface)] = g_window;
+    }
+    return vr;
+  }
+
+  static bool createAndroidDriver(WsiDriver **driver) {
+    *driver = new AndroidWsiDriver();
+    return true;
+  }
+
+  WsiBootstrap AndroidWSI = {
+    "Android",
+    createAndroidDriver
+  };
+
+}
+
+#endif
