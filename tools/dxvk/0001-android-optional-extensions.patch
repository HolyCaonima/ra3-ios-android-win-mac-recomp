diff --git a/include/native/wsi/native_android.h b/include/native/wsi/native_android.h
new file mode 100644
index 0000000..da8b3f4
--- /dev/null
+++ b/include/native/wsi/native_android.h
@@ -0,0 +1,22 @@
+#pragma once
+
+/* RA3 (liftingCPath D007): the WSI handle on Android. There is one window at
+ * a time, an ANativeWindow that comes and goes with the activity; the HWND
+ * the game holds is a stable token, and the window behind it is swapped by
+ * the shell (dxvk_android_set_window, wsi_platform_android.cpp). */
+
+#include <windows.h>
+
+struct ANativeWindow;
+
+namespace dxvk::wsi {
+
+  inline HWND androidHwnd() {
+    return reinterpret_cast<HWND>(uintptr_t(0xA11D0001u));
+  }
+
+  inline bool isAndroidHwnd(HWND hWindow) {
+    return hWindow == androidHwnd();
+  }
+
+}
