+#pragma once
+
+#include "../wsi_platform.h"
+
+namespace dxvk::wsi {
+
+  // One UIKit-owned CAMetalLayer, with physical size published by layout.
+  class IosWsiDriver : public WsiDriver {
+  public:
+    std::vector<const char *> getInstanceExtensions() override;
+
+    HMONITOR getDefaultMonitor() override;
+    HMONITOR enumMonitors(uint32_t index) override;
+    HMONITOR enumMonitors(const LUID *adapterLUID[], uint32_t numLUIDs, uint32_t index) override;
+    bool getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) override;
+    bool getDesktopCoordinates(HMONITOR hMonitor, RECT* pRect) override;
+    bool getDisplayMode(HMONITOR hMonitor, uint32_t modeNumber, WsiMode* pMode) override;
+    bool getCurrentDisplayMode(HMONITOR hMonitor, WsiMode* pMode) override;
+    bool getDesktopDisplayMode(HMONITOR hMonitor, WsiMode* pMode) override;
+    WsiEdidData getMonitorEdid(HMONITOR hMonitor) override;
+
+    void getWindowSize(HWND hWindow, uint32_t* pWidth, uint32_t* pHeight) override;
+    void resizeWindow(HWND hWindow, DxvkWindowState* pState, uint32_t width, uint32_t height) override;
+    void saveWindowState(HWND hWindow, DxvkWindowState* pState, bool saveStyle) override;
+    void restoreWindowState(HWND hWindow, DxvkWindowState* pState, bool restoreCoordinates) override;
+    bool setWindowMode(HMONITOR hMonitor, HWND hWindow, DxvkWindowState* pState, const WsiMode& mode) override;
+    bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow, DxvkWindowState* pState, bool modeSwitch) override;
+    bool leaveFullscreenMode(HWND hWindow, DxvkWindowState* pState) override;
+    bool restoreDisplayMode() override;
+    HMONITOR getWindowMonitor(HWND hWindow) override;
+    bool isWindow(HWND hWindow) override;
+    bool isMinimized(HWND hWindow) override;
+    bool isOccluded(HWND hWindow) override;
+    void updateFullscreenWindow(HMONITOR hMonitor, HWND hWindow, bool forceTopmost) override;
+    VkResult createSurface(HWND hWindow, PFN_vkGetInstanceProcAddr pfnVkGetInstanceProcAddr,
+                           VkInstance instance, VkSurfaceKHR* pSurface) override;
+  };
+
+}
--- /dev/null
+++ b/src/wsi/ios/wsi_platform_ios.cpp
@@ -0,0 +1,95 @@
+#if defined(DXVK_WSI_IOS)
+#include "wsi_platform_ios.h"
+#include <mutex>
+#include <vulkan/vulkan_metal.h>
+
+namespace {
+std::mutex mutex;
+void* layer = nullptr;
+uint32_t width = 1280, height = 720, logicalW = 1280, logicalH = 720;
+int32_t regionSrc[4] = {}, regionDst[4] = {};
+uint32_t regionSurface[2] = {}, regionGame[2] = {};
+bool active = true;
+}
+extern "C" {
+void dxvk_ios_set_layer(void* value, uint32_t w, uint32_t h) {
+  std::lock_guard<std::mutex> lock(mutex);
+  layer=value; width=w; height=h;
+}
+void dxvk_ios_set_active(int value) {
+  std::lock_guard<std::mutex> lock(mutex); active=value;
+}
+void dxvk_ios_set_present_region(const int32_t* src, const int32_t* dst,
+    const uint32_t* surface, const uint32_t* game) {
+  std::lock_guard<std::mutex> lock(mutex);
+  std::memcpy(regionSrc,src,sizeof(regionSrc)); std::memcpy(regionDst,dst,sizeof(regionDst));
+  std::memcpy(regionSurface,surface,sizeof(regionSurface)); std::memcpy(regionGame,game,sizeof(regionGame));
+}
+int dxvk_ios_get_present_region(int32_t* src, int32_t* dst, uint32_t* surface, uint32_t* game) {
+  std::lock_guard<std::mutex> lock(mutex);
+  if (!regionDst[2] || !regionDst[3]) return 0;
+  std::memcpy(src,regionSrc,sizeof(regionSrc)); std::memcpy(dst,regionDst,sizeof(regionDst));
+  std::memcpy(surface,regionSurface,sizeof(regionSurface)); std::memcpy(game,regionGame,sizeof(regionGame));
+  return 1;
+}
+}
+namespace dxvk::wsi {
+static HMONITOR monitor = reinterpret_cast<HMONITOR>(uintptr_t(1));
+std::vector<const char*> IosWsiDriver::getInstanceExtensions() {
+  return { VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_METAL_SURFACE_EXTENSION_NAME };
+}
+HMONITOR IosWsiDriver::getDefaultMonitor() { return monitor; }
+HMONITOR IosWsiDriver::enumMonitors(uint32_t i) { return i ? nullptr : monitor; }
+HMONITOR IosWsiDriver::enumMonitors(const LUID*[], uint32_t, uint32_t i) { return enumMonitors(i); }
+bool IosWsiDriver::getDisplayName(HMONITOR m, WCHAR (&name)[32]) {
+  if (m!=monitor) return false;
+  const WCHAR value[]={'I','P','A','D',0}; std::memcpy(name,value,sizeof(value)); return true;
+}
+bool IosWsiDriver::getDesktopCoordinates(HMONITOR m, RECT* rect) {
+  if (m!=monitor) return false;
+  std::lock_guard<std::mutex> lock(mutex); *rect={0,0,LONG(logicalW),LONG(logicalH)}; return true;
+}
+bool IosWsiDriver::getDisplayMode(HMONITOR m, uint32_t i, WsiMode* mode) {
+  static const uint32_t modes[][2]={{800,600},{1024,768},{1280,720},{1280,800},{1600,900},{1920,1080}};
+  if (m!=monitor || i>=std::size(modes)) return false;
+  mode->width=modes[i][0]; mode->height=modes[i][1]; mode->refreshRate={60,1};
+  mode->bitsPerPixel=32; mode->interlaced=false; return true;
+}
+bool IosWsiDriver::getCurrentDisplayMode(HMONITOR m,WsiMode* mode) {
+  if (m!=monitor) return false;
+  std::lock_guard<std::mutex> lock(mutex); mode->width=logicalW; mode->height=logicalH;
+  mode->refreshRate={60,1}; mode->bitsPerPixel=32; mode->interlaced=false; return true;
+}
+bool IosWsiDriver::getDesktopDisplayMode(HMONITOR m,WsiMode* mode) { return getCurrentDisplayMode(m,mode); }
+WsiEdidData IosWsiDriver::getMonitorEdid(HMONITOR) { return {}; }
+void IosWsiDriver::getWindowSize(HWND,uint32_t* w,uint32_t* h) {
+  std::lock_guard<std::mutex> lock(mutex); if(w)*w=width; if(h)*h=height;
+}
+void IosWsiDriver::resizeWindow(HWND,DxvkWindowState*,uint32_t w,uint32_t h) {
+  std::lock_guard<std::mutex> lock(mutex); if(w && h) {logicalW=w; logicalH=h;}
+}
+void IosWsiDriver::saveWindowState(HWND,DxvkWindowState*,bool) {}
+void IosWsiDriver::restoreWindowState(HWND,DxvkWindowState*,bool) {}
+bool IosWsiDriver::setWindowMode(HMONITOR,HWND w,DxvkWindowState* s,const WsiMode& m) {resizeWindow(w,s,m.width,m.height); return true;}
+bool IosWsiDriver::enterFullscreenMode(HMONITOR,HWND,DxvkWindowState*,bool) {return true;}
+bool IosWsiDriver::leaveFullscreenMode(HWND,DxvkWindowState*) {return true;}
+bool IosWsiDriver::restoreDisplayMode() {return true;}
+HMONITOR IosWsiDriver::getWindowMonitor(HWND) {return monitor;}
+bool IosWsiDriver::isWindow(HWND w) {return uintptr_t(w)==1;}
+bool IosWsiDriver::isMinimized(HWND) {std::lock_guard<std::mutex> lock(mutex); return !active || !layer;}
+bool IosWsiDriver::isOccluded(HWND w) {return isMinimized(w);}
+void IosWsiDriver::updateFullscreenWindow(HMONITOR,HWND,bool) {}
+VkResult IosWsiDriver::createSurface(HWND w,PFN_vkGetInstanceProcAddr proc,VkInstance instance,VkSurfaceKHR* surface) {
+  if(!isWindow(w)) return VK_ERROR_SURFACE_LOST_KHR;
+  auto create=reinterpret_cast<PFN_vkCreateMetalSurfaceEXT>(proc(instance,"vkCreateMetalSurfaceEXT"));
+  if(!create) return VK_ERROR_EXTENSION_NOT_PRESENT;
+  std::lock_guard<std::mutex> lock(mutex);
+  if(!layer) return VK_ERROR_SURFACE_LOST_KHR;
+  VkMetalSurfaceCreateInfoEXT info={VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT};
+  info.pLayer=static_cast<const CAMetalLayer*>(layer);
+  return create(instance,&info,nullptr,surface);
+}
+static bool createDriver(WsiDriver** driver) {*driver=new IosWsiDriver(); return true;}
+WsiBootstrap IosWSI={"iOS",createDriver};
+}
+#endif
