+  // RA3: mobile GPUs may lack scaled integer vertex formats. Keep the same
+  // bytes/stride, fetch integers, and convert in the specialized vertex shader.
+  static VkFormat androidVertexFormat(const DxvkDevice* device, VkFormat format) {
+#ifdef __ANDROID__
+    if (device->getFormatFeatures(format).buffer & VK_FORMAT_FEATURE_2_VERTEX_BUFFER_BIT)
+      return format;
+    VkFormat fallback = format;
+    switch (format) {
+      case VK_FORMAT_R8G8B8A8_USCALED: fallback = VK_FORMAT_R8G8B8A8_UINT; break;
+      case VK_FORMAT_R16G16_SSCALED: fallback = VK_FORMAT_R16G16_SINT; break;
+      case VK_FORMAT_R16G16B16A16_SSCALED: fallback = VK_FORMAT_R16G16B16A16_SINT; break;
+      default: break;
+    }
+    if (device->getFormatFeatures(fallback).buffer & VK_FORMAT_FEATURE_2_VERTEX_BUFFER_BIT)
+      return fallback;
+#endif
+    return format;
+  }
+
 
