+    if (linkage && m_metadata.stage == VK_SHADER_STAGE_VERTEX_BIT &&
+        (linkage->vsScaledSigned | linkage->vsScaledUnsigned)) {
+      using namespace dxbc_spv;
+      std::vector<ir::SsaDef> inputs;
+      for (auto it = irBuilder.begin(); it != irBuilder.getDeclarations().second; ++it)
+        if (it->getOpCode() == ir::OpCode::eDclInput)
+          inputs.push_back(it->getDef());
+      for (auto def : inputs) {
+        auto decl = irBuilder.getOp(def);
+        uint32_t location = uint32_t(decl.getOperand(1u));
+        if (location >= 32u || !((linkage->vsScaledSigned | linkage->vsScaledUnsigned) & (1u << location)))
+          continue;
+        auto scalar = (linkage->vsScaledSigned & (1u << location))
+          ? ir::ScalarType::eI32 : ir::ScalarType::eU32;
+        auto oldType = decl.getType();
+        if (oldType.getBaseType(0u).getBaseType() != ir::ScalarType::eF32)
+          throw DxvkError("RA3: scaled vertex input is not float");
+        ir::Type integerType;
+        for (uint32_t i = 0; i < oldType.getStructMemberCount(); i++)
+          integerType.addStructMember(ir::BasicType(scalar, oldType.getBaseType(i).getVectorSize()));
+        for (uint32_t i = 0; i < oldType.getArrayDimensions(); i++)
+          integerType.addArrayDimension(oldType.getArraySize(i));
+        std::vector<ir::SsaDef> uses;
+        irBuilder.getUses(def, uses);
+        irBuilder.rewriteOp(def, ir::Op(decl).setType(integerType));
+        for (auto use : uses) {
+          auto load = irBuilder.getOp(use);
+          if (load.getOpCode() != ir::OpCode::eInputLoad)
+            continue;
+          auto loadType = ir::BasicType(scalar, load.getType().getBaseType(0u).getVectorSize());
+          auto integerLoad = irBuilder.addBefore(use, ir::Op(load).setType(loadType));
+          irBuilder.rewriteOp(use, ir::Op::ConvertItoF(load.getType(), integerLoad));
+        }
+      }
+    }
