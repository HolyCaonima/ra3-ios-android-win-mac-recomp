-void MVKDevice::encodeGPUAddressableBuffers(MVKUseResourceHelper& resources, MVKResourceUsageStages stage) {
+void MVKDevice::encodeGPUAddressableBuffers(MVKUseResourceHelper& resources, MVKResourceUsageStages stage, id<MTLCommandBuffer> commandBuffer) {
 	lock_guard<mutex> lock(_rezLock);
+#if MVK_IOS
+	// This residency list includes buffers that the application does not use in
+	// this submission. It may legally destroy those buffers while this command
+	// buffer is pending. Retain the Metal snapshot under the registry lock,
+	// including the interval before deferred useResources encoding, until GPU
+	// completion. Do not retain the Vulkan objects or defer frees indefinitely.
+	NSMutableArray<id<MTLBuffer>>* retainedBuffers = [[NSMutableArray alloc] initWithCapacity: _gpuAddressableBuffers.size()];
+#endif
 	for (auto& buff : _gpuAddressableBuffers) {
-		resources.add(buff->getMTLBuffer(), stage, true);
+		id<MTLBuffer> buffer = buff->getMTLBuffer();
+#if MVK_IOS
+		if (buffer) { [retainedBuffers addObject: buffer]; }
+#endif
+		resources.add(buffer, stage, true);
 	}
+#if MVK_IOS
+	// Metal copies the block and retains its Objective-C captures. Empty the
+	// snapshot at completion even if the command buffer itself is pooled.
+	[commandBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) {
+		[retainedBuffers removeAllObjects];
+	}];
+	[retainedBuffers release];
+#endif
 }
 
